{
  "name": "stockforge",
  "version": "1.4.3",
  "description": "StockForge — AI-powered stock trading assistant",
  "main": "main.js",
  "author": "StockForge",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg --arm64",
    "build:universal": "electron-builder --mac dmg --universal",
    "build:all": "electron-builder --mac dmg --x64 --arm64"
  },
  "build": {
    "appId": "com.stockforge.app",
    "productName": "StockForge",
    "icon": "assets/icon.icns",
    "publish": {
      "provider": "github",
      "owner": "rvempati",
      "repo": "stockforge"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "StockForge",
      "icon": "assets/icon.icns"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/fira-sans": "^5.2.7",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
